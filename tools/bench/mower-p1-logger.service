[Unit]
Description=MOWER P1 SWD drive-state logger (chip1 A4963/PWM/state, non-halt)
# Стартовать после openocd; если openocd перезапустится — демон сам реконнектит.
After=mower-openocd.service network-online.target
Wants=mower-openocd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mower-bench
# Запуск через shebang (#!/usr/bin/env python3) — без слова python3 в systemd/ssh.
ExecStart=/home/pi/mower-bench/p1_logger_daemon.py
Restart=always
RestartSec=3
# Не глушить при коротких падениях линка (демон сам реконнектит вечно).
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
