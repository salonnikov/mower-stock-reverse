[Unit]
Description=MOWER P1 SWD drive-state logger (chip1 A4963/PWM/state, non-halt)
# Start after openocd; if openocd restarts — the daemon reconnects on its own.
After=mower-openocd.service network-online.target
Wants=mower-openocd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mower-bench
# Launch via shebang (#!/usr/bin/env python3) — without the word python3 in systemd/ssh.
ExecStart=/home/pi/mower-bench/p1_logger_daemon.py
Restart=always
RestartSec=3
# Don't give up on short link drops (the daemon reconnects forever on its own).
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
